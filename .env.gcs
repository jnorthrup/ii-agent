# II-Agent Configuration
# This file is sourced by bashrc for GCS credentials

# Google Cloud Storage Configuration
export GOOGLE_CLOUD_PROJECT="your-project-id"
export GCS_BUCKET_NAME="ii-agent-storage"

# Storage Provider (gcs or local)
export STORAGE_PROVIDER="gcs"
export STORAGE_BUCKET="ii-agent-storage"
# export STORAGE_PROJECT_ID="your-project-id"  # Optional, auto-detected

# If you have a service account key file:
# export GOOGLE_APPLICATION_CREDENTIALS="/path/to/your/credentials.json"

# Or paste credentials JSON directly (for testing):
# export GOOGLE_CREDENTIALS='{"type":"service_account","project_id":"..."}'

# API Keys
export ANTHROPIC_API_KEY="your-anthropic-key"
export OPENAI_API_KEY="your-openai-key"

# Database
export DATABASE_URL="sqlite+aiosqlite:///./ii_agent.db"

# File Store (for local fallback)
export FILE_STORE="local"
export FILE_STORE_PATH="~/.ii_agent"
